# Copy to .env (local) or .env.prod (Cloud Run deploy) and fill in.
# Every setting is read from the environment by app/config.py; defaults below match docker-compose.
# Never commit .env / .env.prod.

# ---------------------------------------------------------------- app
APP_ENV=dev                         # dev | test | prod
LOG_LEVEL=INFO
LOG_JSON=true                       # JSON lines (Cloud Logging parses them); false = readable text
# Origins allowed to call the API (and, via scripts/init_storage, the bucket). Comma-separated, or *.
CORS_ORIGINS=*
# Shared API keys, comma-separated. When set, every request needs the header X-API-Key: <key>
# (or ?api_key=<key> for EventSource). /health, /docs and *.m3u8 playlists stay open.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Absolute base for links the API returns (playlist URLs). Leave empty to use the request's host.
# On Cloud Run, set it to the service URL, e.g. https://minedtv-api-xxxxx-ue.a.run.app
PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------- database (Postgres + pgvector)
# Local: the compose Postgres. Supabase: Connect -> "Transaction pooler" string, with the
# driver changed to postgresql+asyncpg://, e.g.
#   postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://minedtv:minedtv@localhost:5432/minedtv
DB_PGBOUNCER=false                  # true when DATABASE_URL is Supabase's pooler (port 6543)
DB_POOL_SIZE=5

# ---------------------------------------------------------------- redis (queue + cache + counters)
# Upstash: the rediss:// URL from the database page (not the REST URL).
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=pipeline
JOB_TIMEOUT_S=3600

# ---------------------------------------------------------------- object storage (S3 API)
STORAGE_BACKEND=s3                  # s3 | local (local = files under LOCAL_STORAGE_DIR, for tests)
# Local SeaweedFS from docker-compose:
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=localsecret
# Cloudflare R2:
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY from an R2 API token (Object Read & Write on the bucket)
# AWS S3: leave S3_ENDPOINT_URL empty, set S3_REGION. GCS: https://storage.googleapis.com + HMAC keys.
S3_BUCKET=minedtv
# Endpoint used to sign URLs handed to clients, if different from S3_ENDPOINT_URL
# (compose uses http://s3:8333 internally but clients need http://localhost:8333;
#  for a phone on your Wi-Fi use http://<your-LAN-IP>:8333; Android emulator: http://10.0.2.2:8333).
S3_PUBLIC_ENDPOINT_URL=
# Public base URL for media (e.g. R2 bucket's r2.dev URL or a custom domain). When set, playlist
# segments and thumbnails use {base}/{key} (cacheable, no expiry) instead of presigned GETs.
STORAGE_PUBLIC_BASE_URL=
PRESIGN_GET_EXPIRES_S=3600
PRESIGN_PUT_EXPIRES_S=3600
LOCAL_STORAGE_DIR=.data/storage

# ---------------------------------------------------------------- ML
# Vector size for frames.embedding / transcripts.embedding. Fixed by the first migration:
# changing it later needs a new migration and re-embedding. CLIP ViT-L/14 = 768, ViT-B/32 = 512.
EMBEDDING_DIM=768
# Each backend: stub | modal | package.module:ClassName (see app/ml/interfaces.py)
EMBEDDER_BACKEND=stub
TRANSCRIBER_BACKEND=stub
HIGHLIGHT_BACKEND=stub
MODAL_APP_NAME=minedtv-ml
EMBED_BATCH_SIZE=32
# Modal credentials for the API/worker when EMBEDDER/TRANSCRIBER_BACKEND=modal and there's no
# ~/.modal.toml (i.e. on Cloud Run). Create at modal.com -> Settings -> API Tokens.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ---------------------------------------------------------------- processing
SEGMENT_SECONDS=2
TRANSCODE_HEIGHT=720                # 720p keeps storage inside R2's 10 GB free tier
TRANSCODE_CRF=23
FRAME_SAMPLE_FPS=1
FRAME_THUMB_WIDTH=320
TRANSCRIPT_MIN_WINDOW_MS=5000
TRANSCRIPT_MAX_WINDOW_MS=10000
AUTO_CLIP_COUNT=3                   # highlight clips created per session when events exist
UPLOAD_CONCURRENCY=8

# ---------------------------------------------------------------- search
SEARCH_CACHE_TTL_S=300
RRF_K=60
SEARCH_SIGNAL_LIMIT=40              # candidates per signal before fusion
CLIP_WINDOW_MS=15000                # suggested window is match ± this
MOMENT_WINDOW_MS=5000               # hits this close together count as one moment

# ---------------------------------------------------------------- counters
COUNTER_FLUSH_INTERVAL_S=30
