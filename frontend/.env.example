# Copy to .env.local and fill in. .env.local is gitignored.
#
# Shared secret for the deployed MinedTV API. Ask Viraj for it.
# No NEXT_PUBLIC_ prefix: this stays on the server and is attached to upstream
# requests by src/app/api/minedtv/[...path]/route.ts. It is never sent to the
# browser and must never be committed.
MINEDTV_API_KEY=

# Override only when pointing at a different deployment or a local stack
# (e.g. http://127.0.0.1:8080 when running backend/docker-compose.yml).
# MINEDTV_API_BASE_URL=https://minedtv-api-818252181045.us-east1.run.app
